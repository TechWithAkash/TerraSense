# copy this file to .env and fill in what you have. everything here is optional -
# the app runs and reasons correctly with zero configuration, using SQLite and rule-based intake.

# only needed if you want LLM-powered free-text parsing, clarifying-question phrasing, and narration polish.
# without it, the system falls back to regex-based extraction and template-based narration.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# defaults to a local SQLite file if left unset. point this at Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/terrasense

# CORS_ORIGINS=["http://localhost:3000"]
